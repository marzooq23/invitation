---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marzooq Weds Farwizah",
  description = "You are cordially invited to celebrate the wedding of Mohamed Marzooq & Farwizah on 20 December 2026.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://marzooq-weds-farwizah.github.io/" />
    <meta property="og:image" content="https://marzooq-weds-farwizah.github.io/og-image.png" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Noto+Sans:wght@300;400;500;600&family=Noto+Sans+Tamil:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh bg-ivory text-charcoal">
    <div
      id="theme-switcher"
      class="fixed right-3 top-3 z-[60] flex items-center gap-2 rounded-full border border-ivory-dark bg-white/70 px-3 py-1.5 backdrop-blur md:right-5"
      aria-label="Preview wedding color themes"
    >
      <svg class="h-4 w-4 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
        <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
        <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
        <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
      </svg>
      <select
        id="theme-select"
        class="cursor-pointer bg-transparent font-body text-xs font-medium uppercase tracking-widest text-charcoal focus:outline-none [&>option]:text-charcoal"
        aria-label="Choose color theme"
      >
        <option value="classic">Classic Gold</option>
        <option value="rose">Rose Blush</option>
        <option value="emerald">Emerald Garden</option>
        <option value="terracotta">Terracotta</option>
        <option value="plum">Plum Dusk</option>
        <option value="navy">Midnight Navy</option>
        <option value="maroon">Velvet Maroon</option>
        <option value="sage">Soft Sage</option>
        <option value="champagne">Champagne</option>
        <option value="violet">Lavender</option>
        <option value="teal">Ocean Teal</option>
        <option value="mocha">Mocha</option>
        <option value="blush">Blush Pink</option>
        <option value="dusty-blue">Dusty Blue</option>
        <option value="amber">Sunset Amber</option>
        <option value="berry">Berry Bloom</option>
        <option value="fern">Forest Fern</option>
        <option value="slate">Cool Slate</option>
        <option value="peach">Peach Bloom</option>
        <option value="mint">Mint Breeze</option>
      </select>
    </div>
    <slot />
    <script>
      const select = document.getElementById("theme-select");
      const saved = localStorage.getItem("wedding-theme");
      if (saved && select) {
        document.documentElement.dataset.theme = saved;
        select.value = saved;
      }
      select?.addEventListener("change", () => {
        const t = select.value;
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem("wedding-theme", t); } catch {}
      });
    </script>
  </body>
</html>
