---
import venueImg from "../../assets/venue-image.png";
---

<section id="venue" class="section-reveal flex flex-col items-center px-6 py-20">
  <div class="flex flex-col items-center gap-8 max-w-lg mx-auto w-full">

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-body text-xs tracking-[0.25em] text-gold-dark uppercase">Location</p>
      <h2 class="font-display text-3xl text-charcoal md:text-4xl">Venue</h2>
      <div class="gold-divider"></div>
    </div>

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-display text-lg text-charcoal">Tamil Nadu Haj Service Society</p>
      <p class="font-body text-sm text-warm-gray leading-relaxed">
        No. 3, Demellows Road, Thattankulam,<br />
        Choolai, Chennai - 600 112.
      </p>
    </div>

    <div class="w-full rounded-lg overflow-hidden shadow-md">
      <img
        src={venueImg.src}
        alt="Tamil Nadu Haj Service Society venue"
        class="w-full h-48 object-cover md:h-64"
        loading="lazy"
      />
    </div>

    <div class="w-full rounded-lg overflow-hidden shadow-md border border-ivory-dark">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3886.0895326230116!2d80.265693275881!3d13.093512012192116!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a5265f07c665335%3A0x5d56c95c16fe4fd8!2sTamil%20Nadu%20Haj%20Service%20Society!5e0!3m2!1sen!2sin!4v1789394338141!5m2!1sen!2sin"
        width="100%"
        height="250"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="Venue location on Google Maps"
        class="w-full"
      ></iframe>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 w-full">
      <a
        href="https://maps.app.goo.gl/Tgnmjrfc2i3Lg7Z96"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg border border-gold px-5 py-3 font-body text-sm text-gold transition-colors hover:bg-gold hover:text-ivory"
      >
        View on Map
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a
        href="https://maps.google.com/?q=Tamil+Nadu+Haj+Service+Society+Chennai"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg bg-gold px-5 py-3 font-body text-sm text-ivory transition-colors hover:bg-gold-dark"
      >
        Get Directions
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
      </a>
    </div>

    <div class="flex flex-col items-center gap-6 mt-4 text-center w-full">

      <!-- Entrance -->
      <div class="flex flex-col items-center gap-2 w-full">
        <p class="font-body text-xs tracking-widest text-gold-dark uppercase">Entrance</p>
        <p class="font-body text-sm text-warm-gray">Separate Entrance for Men's and Women's Hall</p>
      </div>

      <!-- Men's Hall Entrance -->
      <div class="w-full flex flex-col items-center gap-3">
        <p class="font-body text-xs tracking-widest text-gold-dark uppercase">Men's Hall Entrance Location</p>
        <div class="w-full rounded-lg overflow-hidden shadow-md border border-ivory-dark">
          <iframe
            src="https://www.google.com/maps/embed?pb=!4v1789402077132!6m8!1m7!1sl7hCjKKb1hKAS2Hhu-1Qww!2m2!1d13.09369470233817!2d80.26857202841211!3f217.31274390008525!4f8.242227995106589!5f0.7820865974627469"
            width="100%"
            height="250"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Men's Hall entrance location"
            class="w-full"
          ></iframe>
        </div>
        <a
          href="https://maps.app.goo.gl/GQoaWzkexbAdKkw67"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gold px-5 py-2.5 font-body text-sm text-gold transition-colors hover:bg-gold hover:text-ivory"
        >
          View on Map
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Women's Hall Entrance -->
      <div class="w-full flex flex-col items-center gap-3">
        <p class="font-body text-xs tracking-widest text-gold-dark uppercase">Women's Hall Entrance Location</p>
        <div class="w-full rounded-lg overflow-hidden shadow-md border border-ivory-dark">
          <iframe
            src="https://www.google.com/maps/embed?pb=!4v1789402126579!6m8!1m7!1sSYK0aU73HycfZBZoI8vU3A!2m2!1d13.09376495130855!2d80.26853298759092!3f261.5596147054839!4f2.3276129292177075!5f3.325193203789971"
            width="100%"
            height="250"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Women's Hall entrance location"
            class="w-full"
          ></iframe>
        </div>
        <a
          href="https://maps.app.goo.gl/xzFwBAYyB9BnnUFN7"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gold px-5 py-2.5 font-body text-sm text-gold transition-colors hover:bg-gold hover:text-ivory"
        >
          View on Map
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="gold-divider"></div>
    </div>

  </div>
</section>
