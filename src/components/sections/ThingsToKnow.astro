---
const svg = (path) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">${path}</svg>`;

const items = [
  {
    title: "Dress Code",
    detail: "We welcome Traditional & Formal attire for the wedding ceremony",
    icon: svg(
      '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>'
    ),
  },
  {
    title: "Arrival",
    detail: "Please arrive 15 minutes before the ceremony",
    icon: svg(
      '<path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>'
    ),
  },
  {
    title: "Parking",
    detail: "Bike and Car parking available inside venue",
    icon: svg(
      '<circle cx="12" cy="12" r="10"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>'
    ),
  },
  {
    title: "Prayer",
    detail: "Men's Prayer Hall available. Luhar (Prayer) starts at 1:00 PM",
    icon: svg(
      '<path d="M12 3l4 4H8l4-4z"/><path d="M4 7h16v2H4z"/><path d="M5 9h14v12H5z"/><path d="M10 21v-3a2 2 0 0 1 4 0v3"/>'
    ),
  },
  {
    title: "Dining",
    detail: "Both Vegetarian & Non-vegetarian options available",
    icon: svg(
      '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>'
    ),
  },
  {
    title: "Photography",
    detail: "We kindly request guests not to take pictures of the Bride or the Guests during the ceremony",
    icon: svg(
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>'
    ),
  },
];
---

<section id="things-to-know" class="section-reveal flex flex-col items-center px-6 py-20">
  <div class="flex flex-col items-center gap-8 max-w-lg mx-auto w-full">

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-body text-xs tracking-[0.25em] text-gold-dark uppercase">Guest Info</p>
      <h2 class="font-display text-3xl text-charcoal md:text-4xl">Things to Know</h2>
      <div class="gold-divider"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full mt-2">
      {items.map((item) => (
        <div class="flex flex-col gap-2 rounded-lg border border-ivory-dark bg-white/50 p-5 transition-shadow hover:shadow-md">
          <div class="flex items-center gap-2.5">
            <span class="text-gold" aria-hidden="true" set:html={item.icon}></span>
            <h3 class="font-display text-base text-charcoal">{item.title}</h3>
          </div>
          <p class="font-body text-sm text-warm-gray leading-relaxed">{item.detail}</p>
        </div>
      ))}
    </div>

  </div>
</section>
