---
const svg = (path) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">${path}</svg>`;

const events = [
  {
    time: "11:30 AM",
    name: "Nikkah",
    description: "The sacred marriage ceremony",
    icon: svg(
      '<path d="M8 5.5C8 4 6.9 3 5.6 3 4 3 3 4.4 3 6c0 1.1.5 2 1.4 2.9L8 12.6l3.6-3.7c.9-.9 1.4-1.8 1.4-2.9 0-1.6-1-3-2.6-3C9.1 3 8 4 8 5.5z"/><path d="M16 5.5C16 4 14.9 3 13.6 3 12 3 11 4.4 11 6c0 1.1.5 2 1.4 2.9L16 12.6l3.6-3.7c.9-.9 1.4-1.8 1.4-2.9 0-1.6-1-3-2.6-3C17.1 3 16 4 16 5.5z"/>'
    ),
  },
  {
    time: "12:00 PM",
    name: "Bayan",
    description: "Eloquent speech",
    icon: svg(
      '<path d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"/>'
    ),
  },
  {
    time: "12:30 PM",
    name: "Walima",
    description: "Wedding feast",
    icon: svg(
      '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>'
    ),
  },
  {
    time: "1:00 PM",
    name: "Luhar",
    description: "Prayer",
    icon: svg(
      '<path d="M12 3l4 4H8l4-4z"/><path d="M4 7h16v2H4z"/><path d="M5 9h14v12H5z"/><path d="M10 21v-3a2 2 0 0 1 4 0v3"/>'
    ),
  },
  {
    time: "2:00 PM",
    name: "Post-Nikah Photo Session",
    description: "Photo session",
    icon: svg(
      '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>'
    ),
  },
];
---

<section id="events" class="section-reveal min-h-dvh flex flex-col items-center px-6 py-20">
  <div class="flex flex-col items-center gap-8 max-w-md mx-auto w-full">

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-body text-xs tracking-[0.25em] text-gold-dark uppercase">Schedule</p>
      <h2 class="font-display text-3xl text-charcoal md:text-4xl">Wedding Events</h2>
      <div class="gold-divider"></div>
      <p class="font-body text-xs text-warm-gray">20 December 2026</p>
    </div>

    <div class="relative w-full mt-4">
      <!-- Vertical line on the left -->
      <div class="absolute left-4 top-0 bottom-0 w-px bg-gold-light"></div>

      {events.map((event) => (
        <div class="relative flex items-start gap-6 mb-10 last:mb-0">
          <!-- Icon -->
          <div class="absolute left-4 -translate-x-1/2 z-10 mt-0.5 flex h-8 w-8 items-center justify-center rounded-full bg-gold text-ivory shadow-sm">
            <Fragment set:html={event.icon} />
          </div>

          <!-- Time (left) -->
          <div class="pl-10 md:pl-12 md:w-40 shrink-0">
            <p class="font-display text-lg text-gold-dark">{event.time}</p>
          </div>

          <!-- Content (right) -->
          <div>
            <h3 class="font-display text-xl text-charcoal">{event.name}</h3>
            <p class="font-body text-sm text-warm-gray mt-1">{event.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
