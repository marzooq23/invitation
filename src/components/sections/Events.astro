---
import { Icon } from 'astro-icon/components';

const events = [
  {
    time: "11:00 AM",
    name: "Welcome",
    description: "Guests are welcomed and seated ahead of the Nikah ceremony.",
    icon: "users",
    iconSet: "lucide",
  },
  {
    time: "11:30 AM",
    name: "Nikkah",
    description: "The sacred marriage ceremony",
    icon: "heart-handshake",
    iconSet: "lucide",
  },
  {
    time: "12:00 PM",
    name: "Bayan",
    description: "Eloquent speech",
    icon: "mic",
    iconSet: "lucide",
  },
  {
    time: "12:30 PM",
    name: "Walima",
    description: "Wedding feast",
    icon: "utensils-crossed",
    iconSet: "lucide",
  },
  {
    time: "1:00 PM",
    name: "Luhar",
    description: "Prayer",
    icon: "mosque",
    iconSet: "lucide",
  },
  {
    time: "2:00 PM",
    name: "Post-Nikah Portrait Session",
    description: "Photo session",
    icon: "camera",
    iconSet: "lucide",
  },
];
---

<section id="events" class="section-reveal min-h-dvh flex flex-col items-center px-6 py-20">
  <div class="flex flex-col items-center gap-8 max-w-md mx-auto w-full">

    <div class="flex flex-col items-center gap-2 text-center">
      <p class="font-body text-xs tracking-[0.25em] text-gold-dark">Schedule</p>
      <h2 class="font-display text-3xl text-charcoal md:text-4xl">Wedding Events</h2>
      <div class="gold-divider"></div>
      <p class="font-body text-xs text-warm-gray">20 December 2026</p>
    </div>

    <div class="relative w-full mt-4">
      {events.map((event, i) => (
        <div class="relative flex items-start gap-6 pb-10 last:pb-0">
          <!-- Vertical line segment (stops before first icon, hidden after last) -->
          {i < events.length - 1 && (
            <div class="absolute left-4 top-[2px] bottom-0 w-px bg-gold-light" aria-hidden="true"></div>
          )}

          <!-- Icon -->
          <div class="absolute left-4 -translate-x-1/2 z-10 mt-0.5 flex h-8 w-8 items-center justify-center rounded-full bg-gold text-ivory shadow-sm">
            {
              event.iconSet === "local" ? (
                <Icon name={event.icon} class="h-4 w-4" aria-hidden="true" />
              ) : (
                <Icon name={`lucide:${event.icon}`} class="h-4 w-4" aria-hidden="true" />
              )
            }
          </div>

          <!-- Time (left) -->
          <div class="pl-10 md:pl-12 md:w-40 shrink-0">
            <p class="font-display text-lg text-gold-dark">{event.time}</p>
          </div>

          <!-- Content (right) -->
          <div>
            <h3 class="font-display text-xl text-charcoal">{event.name}</h3>
            <p class="font-body text-sm text-warm-gray mt-1">{event.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
