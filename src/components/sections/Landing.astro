---
---

<section id="landing" class="relative min-h-dvh flex flex-col items-center justify-center px-6 py-16 text-center">
  <div class="flex flex-col items-center gap-6 max-w-lg mx-auto">
    <p class="font-arabic text-2xl leading-relaxed text-gold-dark md:text-3xl" dir="rtl">
      بِسْمِ ٱللهِ ٱلرَّحْمَٰنِ ٱلرَّحِيْمِ
    </p>

    <p class="font-body text-sm tracking-widest text-warm-gray uppercase">
      Bismillahir Rahmanir Raheem
    </p>

    <div class="gold-divider-wide my-2"></div>

    <p class="font-body text-sm leading-relaxed text-warm-gray">
      With the blessings of Allah (SWT)<br />
      and the love of our families,
    </p>

    <div class="flex flex-col items-center gap-2 mt-2">
      <h1 class="font-display text-4xl font-light tracking-wide text-charcoal sm:text-5xl md:text-6xl">
        Mohamed Marzooq
      </h1>
      <span class="font-display text-3xl text-gold italic">&amp;</span>
      <h1 class="font-display text-4xl font-light tracking-wide text-charcoal sm:text-5xl md:text-6xl">
        Farwizah
      </h1>
    </div>

    <p class="font-body text-sm leading-relaxed text-warm-gray mt-2 max-w-xs">
      We invite you to celebrate the beginning of their new journey together.
    </p>

    <div class="gold-divider my-4"></div>

    <div class="flex flex-col items-center gap-1">
      <p class="font-display text-lg tracking-widest text-gold-dark uppercase">Sunday</p>
      <div class="flex items-baseline gap-3">
        <span class="font-display text-5xl font-light text-charcoal md:text-6xl">20</span>
        <span class="font-display text-lg text-warm-gray">/</span>
        <span class="font-display text-3xl font-light text-charcoal">12</span>
        <span class="font-display text-lg text-warm-gray">/</span>
        <span class="font-display text-3xl font-light text-charcoal">2026</span>
      </div>
      <p class="font-body text-xs tracking-widest text-warm-gray-light uppercase mt-1">20 December 2026</p>
    </div>

    <div class="flex items-center gap-4 mt-6 text-center" id="countdown">
      <div class="flex flex-col items-center">
        <span class="font-display text-2xl text-charcoal tabular-nums md:text-3xl" id="cd-days">---</span>
        <span class="font-body text-[10px] tracking-widest text-warm-gray-light uppercase">Days</span>
      </div>
      <span class="text-gold-light text-lg">:</span>
      <div class="flex flex-col items-center">
        <span class="font-display text-2xl text-charcoal tabular-nums md:text-3xl" id="cd-hours">--</span>
        <span class="font-body text-[10px] tracking-widest text-warm-gray-light uppercase">Hrs</span>
      </div>
      <span class="text-gold-light text-lg">:</span>
      <div class="flex flex-col items-center">
        <span class="font-display text-2xl text-charcoal tabular-nums md:text-3xl" id="cd-mins">--</span>
        <span class="font-body text-[10px] tracking-widest text-warm-gray-light uppercase">Min</span>
      </div>
      <span class="text-gold-light text-lg">:</span>
      <div class="flex flex-col items-center">
        <span class="font-display text-2xl text-charcoal tabular-nums md:text-3xl" id="cd-secs">--</span>
        <span class="font-body text-[10px] tracking-widest text-warm-gray-light uppercase">Sec</span>
      </div>
    </div>

    <a
      href="#nikkah-english"
      class="mt-10 flex flex-col items-center gap-1 text-warm-gray-light transition-colors hover:text-gold"
    >
      <span class="font-body text-[11px] tracking-[0.2em] uppercase">Explore the Invitation</span>
      <svg class="h-4 w-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</section>
